# Environment Configuration
# Copy this file to .env.local and update the values below.

# Base URL for the backend API
NEXT_PUBLIC_API_ENDPOINT=http://127.0.0.1:4000

# Authentication mode: 'demo' (mock) or 'api' (real backend)
NEXT_PUBLIC_AUTH_MODE=demo

# Blog mode: 'mock' (local data) or 'api' (real backend)
NEXT_PUBLIC_BLOG_MODE=mock

# Profile mode: 'mock' (local data) or 'api' (real backend)
NEXT_PUBLIC_PROFILE_MODE=mock

# User mode: 'mock' (local data) or 'api' (real backend)
NEXT_PUBLIC_USER_MODE=mock
